# Copy to .env and fill in. Every value below is empty by default.

# Required — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required — public /mcp URL of the local k8s MCP server + cloudflared tunnel.
# Printed by scripts/run-k8s-mcp.sh; rotates every time you restart that script.
K8S_MCP_URL=

# Namespace the agent is restricted to investigate (see provided.py's
# SYSTEM_PROMPT). Set to "" to lift the restriction and let it look at any
# namespace it finds.
K8S_NAMESPACE=scenario-01

# Optional — Grafana MCP server URL (see docs/grafana.md). Leave both
# GRAFANA_MCP_URL and GRAFANA_TOKEN empty to skip Grafana entirely.
GRAFANA_MCP_URL=https://grafana.chaos1.causely.app/mcp
GRAFANA_TOKEN=

# Optional — set ENABLE_CAUSELY=1 to add the Causely MCP server + toolset.
# Requires a Causely tenant; leave everything below empty otherwise.
ENABLE_CAUSELY=
CAUSELY_MCP_URL=https://api.staging.causely.app/mcp
CAUSELY_CLIENT_ID=
CAUSELY_CLIENT_SECRET=
# Your tenant's OAuth client-credentials token endpoint. Ask your Causely
# contact for the exact URL — this is not a fixed, guessable value. The JSON
# key holding the token in the response also varies by tenant/endpoint
# version (access_token, accessToken, or token) — agent.py checks all three;
# confirm your tenant's actual shape if token fetch fails.
CAUSELY_TOKEN_URL=https://auth.staging.causely.app/frontegg/identity/resources/auth/v2/api-token

# Optional — set to enable webhook.py, which turns Causely notifications
# into agent investigations (see docs/causely-webhook.md). This is the
# shared secret Causely sends back as its notification token; webhook.py
# checks it on every inbound call. Leave empty to skip this entirely.
CAUSELY_WEBHOOK_SECRET=

# Optional — mount a GitHub repo checkout into the agent's sandbox at
# session creation. Leave GITHUB_REPO_URL empty to skip this entirely.
GITHUB_REPO_URL=https://github.com/Causely/development-environment
# A GitHub personal access token with repo read access. Required for
# private repos; omit for public ones.
GITHUB_TOKEN=
# Branch to check out. Leave empty to use the repo's default branch.
GITHUB_BRANCH=chore/billing-http-client-pooling
# Where the repo is mounted inside the agent's sandbox.
GITHUB_MOUNT_PATH=/workspace/repo
